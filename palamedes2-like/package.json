{
  "name": "palamedes2-like",
  "version": "0.1.0",
  "private": true,
  "description": "パラメデス２風ブラウザ対戦パズル 基本動作検証版",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "serve:dist": "node scripts/serve.mjs dist 8080",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
