{
  "name": "palamedes2-like",
  "version": "3.0.0-rc.1",
  "private": true,
  "description": "コタローくんパズル 第3版統合候補 v3.0.0-rc1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "serve:dist": "node scripts/serve.mjs dist 8080",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e",
    "e2e:fallback": "node scripts/e2e.mjs --fallback",
    "check:release": "node scripts/check-release.mjs",
    "verify:fallback": "npm run typecheck && npm run test && npm run build && npm run e2e:fallback",
    "measure:cpu": "vitest run --config tools/vitest.measure.config.ts",
    "measure:mix": "node tools/mix-peak.mjs",
    "assemble:play": "node scripts/assemble-play.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
